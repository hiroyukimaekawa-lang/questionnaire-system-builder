{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questionnaire-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "questionnaire-staging"
    }
  ],
  "ratelimits": [
    {
      "name": "SURVEY_RESPONSE_RATE_LIMITER",
      "namespace_id": "2026092501",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "account_id": "739ef6b0d4cc5d4e1b5fb1a1ebae94af",
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://questionnaire-staging.survey-system.workers.dev"
  }
}
